#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SCRIPT_DIR" || exit 1

# Mirror the VSCode emeraldwalk.runonsave action (see .vscode/settings.json):
# format staged .tw files and re-stage so the commit lands canonicalised.
staged_tw=$(git diff --cached --name-only --diff-filter=ACM -- '*.tw')
if [ -n "$staged_tw" ]; then
  echo "Formatting staged .tw files..."
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    python3 tools/format_twee.py "$f" || { echo "Formatter failed on $f. Commit aborted."; exit 1; }
    git add -- "$f"
  done <<< "$staged_tw"
fi

echo "Running build before commit..."
bash "$SCRIPT_DIR/scripts/build.sh"

echo "Running lint before commit..."
npm run lint
if [ $? -ne 0 ]; then
  echo "Lint failed. Commit aborted."
  exit 1
fi

if [ ! -d "node_modules/@playwright/test" ]; then
  echo "Playwright not installed. Running npm install..."
  npm install || { echo "npm install failed. Commit aborted."; exit 1; }
fi

echo "Running Playwright lint specs before commit..."
npx playwright test --config=config/playwright.config.js --project=lint
if [ $? -ne 0 ]; then
  echo "Playwright lint specs failed. Commit aborted."
  exit 1
fi
